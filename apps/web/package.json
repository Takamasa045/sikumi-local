{
  "name": "@sikumi-local/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184",
